# Copy to .env and fill in. Never commit .env.

# --- Backend ---
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Leave empty to run without it: the copilot uses the offline planner, and voice/photo input
# fall back to browser speech recognition or show a "needs a key" message.
# In production this comes from Secret Manager.
GEMINI_API_KEY=
# Model ids (change as new Gemini models ship)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OMNI_MODEL=gemini-2.5-flash

# Signs TripPass QR codes. Optional locally (a random key is used per run); required in production.
TRIPPASS_SIGNING_KEY=

# Optional locally: without them, data is kept in memory and resets on restart.
# Example: postgresql://kognisync:kognisync@localhost:5432/kognisync
DATABASE_URL=
# Example: redis://localhost:6379/0
REDIS_URL=

# Lets the demo inject disruptions through the API. Keep false in production.
ENABLE_SIMULATION=true

# --- Frontend (Vite) ---
# Leave empty in local dev: Vite proxies /api to the backend on port 8000.
VITE_API_BASE_URL=
